{
    "name": "Material Nova Gruvbox",
    "semanticHighlighting": true,
    "tokenColors": [
        {
            "name": "Global settings",
            "settings": {
                "background": "#1D2021",
                "foreground": "#FBF1C7"
            }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": {
                "foreground": "#B8BB26"
            }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation, constant.other.symbol",
            "settings": {
                "foreground": "#8EC07C"
            }
        },
        {
            "name": "String Escape",
            "scope": "constant.character.escape, text.html constant.character.entity.named",
            "settings": {
                "foreground": "#FBF1C7"
            }
        },
        {
            "name": "Boolean",
            "scope": "constant.language.boolean",
            "settings": {
                "foreground": "#FE8019"
            }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": {
                "foreground": "#D65D0E"
            }
        },
        {
            "name": "Variable",
            "scope": "variable, variable.parameter, support.variable, variable.language, support.constant, meta.definition.variable entity.name.function, meta.function-call.arguments",
            "settings": {
                "foreground": "#FBF1C7"
            }
        },
        {
            "name": "Other Keyword",
            "scope": "keyword.other",
            "settings": {
                "foreground": "#D65D0E"
            }
        },
        {
            "name": "Keyword",
