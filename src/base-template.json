{
    "name": "{themeName}",
    "semanticHighlighting": true,
    "tokenColors": [
        {
            "name": "Global settings",
            "settings": {
                "background": "{tokenColors.0.Global_settings.background}",
                "foreground": "{tokenColors.0.Global_settings.foreground}"
            }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": {
                "foreground": "{tokenColors.1.String.foreground}"
            }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation, constant.other.symbol",
            "settings": {
                "foreground": "{tokenColors.2.Punctuation.foreground}"
            }
        },
        {
            "name": "String Escape",
            "scope": "constant.character.escape, text.html constant.character.entity.named",
            "settings": {
                "foreground": "{tokenColors.3.String_Escape.foreground}"
            }
        },
        {
            "name": "Boolean",
            "scope": "constant.language.boolean",
            "settings": {
                "foreground": "{tokenColors.4.Boolean.foreground}"
            }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": {
                "foreground": "{tokenColors.5.Number.foreground}"
            }
        },
        {
            "name": "Variable",
            "scope": "variable, variable.parameter, support.variable, variable.language, support.constant, meta.definition.variable entity.name.function, meta.function-call.arguments",
            "settings": {
                "foreground": "{tokenColors.6.Variable.foreground}"
            }
        },
        {
            "name": "Other Keyword",
            "scope": "keyword.other",
            "settings": {
                "foreground": "{tokenColors.7.Other_Keyword.foreground}"
            }
        },
        {
            "name": "Keyword",
