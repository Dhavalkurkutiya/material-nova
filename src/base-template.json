            "settings": {
                "foreground": "{tokenColors.8.Keyword.foreground}"
            }
        },
        {
            "name": "Function call",
            "scope": "entity.name.function, support.function",
            "settings": {
                "foreground": "{tokenColors.9.Function_call.foreground}"
            }
        },
        {
            "name": "Storage",
