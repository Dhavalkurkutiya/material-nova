{
  "name": "vsc-material-nova",
  "displayName": "Material Nova — Premium VS Code Theme",
  "description": "The ultimate Material Theme! Premium dark & light variants (similar to One Dark Pro, Dracula, Tokyo Night, Ayu) optimized for elegant coding.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dhavalkurkutiya/material-nova"
  },
  "version": "2.3.0",
  "publisher": "dhavalkurkutiya",
  "author": "Dhaval Kurkutiya (https://github.com/Dhavalkurkutiya)",
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#11131C",
    "theme": "dark"
  },
  "homepage": "https://github.com/Dhavalkurkutiya/material-nova",
  "engines": {
    "node": ">=12",
    "vscode": "^1.51.0"
  },
  "scripts": {
    "build": "node build.js",
    "release": "git pull && standard-version && git push --follow-tags",
    "release:patch": "git pull && standard-version --release-as patch && git push --follow-tags",
    "release:major": "git pull && standard-version --release-as major && git push --follow-tags"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "material theme",
    "vscode theme",
    "dark theme",
    "color theme",
    "palenight",
    "ocean theme",
    "deepforest",
    "one dark pro",
    "dracula",
    "tokyo night",
    "ayu",
    "syntax highlighting",
    "material design",
    "night theme",
    "elegant theme",
    "professional theme",
    "best vscode theme",
    "developer theme",
    "coding theme",
    "high contrast theme"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "themes": [
      {
        "label": "Material Nova",
        "path": "./build/themes/Material-Nova-Default.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova High Contrast",
        "path": "./build/themes/Material-Nova-Default-High-Contrast.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Darker",
        "path": "./build/themes/Material-Nova-Darker.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Darker High Contrast",
        "path": "./build/themes/Material-Nova-Darker-High-Contrast.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Palenight",
        "path": "./build/themes/Material-Nova-Palenight.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Palenight High Contrast",
        "path": "./build/themes/Material-Nova-Palenight-High-Contrast.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Ocean",
        "path": "./build/themes/Material-Nova-Ocean.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Ocean High Contrast",
        "path": "./build/themes/Material-Nova-Ocean-High-Contrast.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Deepforest",
        "path": "./build/themes/Material-Nova-Deepforest.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova DeepForest High Contrast",
        "path": "./build/themes/Material-Nova-Deepforest-High-Contrast.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Lighter",
        "path": "./build/themes/Material-Nova-Lighter.json",
        "uiTheme": "vs"
      },
      {
        "label": "Material Nova Lighter High Contrast",
        "path": "./build/themes/Material-Nova-Lighter-High-Contrast.json",
        "uiTheme": "vs"
      },
      {
        "label": "Material Nova Sakura",
        "path": "./build/themes/Material-Nova-Sakura.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Nebula",
        "path": "./build/themes/Material-Nova-Nebula.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Nebula High Contrast",
        "path": "./build/themes/Material-Nova-Nebula-High-Contrast.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Gruvbox",
        "path": "./build/themes/Material-Nova-Gruvbox.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Gruvbox High Contrast",
        "path": "./build/themes/Material-Nova-Gruvbox-High-Contrast.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Synthwave",
        "path": "./build/themes/Material-Nova-Synthwave.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Material Nova Synthwave High Contrast",
        "path": "./build/themes/Material-Nova-Synthwave-High-Contrast.json",
        "uiTheme": "vs-dark"
      }
    ]
  },
  "devDependencies": {
    "standard-version": "9.5.0",
    "vscode": "1.1.37"
  }
}
